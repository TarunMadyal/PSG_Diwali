# Production Supabase configuration. The publishable key is safe for browser use;
# authorization is enforced by grants, RLS, and the database RPCs.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Keep true until a Supabase project is connected. Demo orders are browser-local
# and are visibly labeled; they are never presented as cloud-persisted orders.
NEXT_PUBLIC_DEMO_MODE=true

# Used for generated tracking links and QR-code deployment configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
